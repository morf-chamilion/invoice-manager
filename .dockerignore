.git
.github
node_modules
vendor
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/media
storage/app/public

# The local package manifest lists require-dev providers (collision, etc.)
# that a --no-dev image does not install. Baked fresh in the runtime stage.
bootstrap/cache/*
!bootstrap/cache/.gitignore
public/js
public/css
public/assets
public/media
public/storage
public/mix-manifest.json
public/hot
.env
.env.*
!.env.example
tests
docker-compose.yml
*.md
!README.md
.phpunit.cache
.phpunit.result.cache

# Database dumps must never be baked into the image
*.sql
*.sql.gz
